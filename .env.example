# GEMINI_API_KEY: Clave de Gemini AI API para análisis de mercado y comandos inteligentes (/ia).
# En AI Studio se inyecta automáticamente desde Secrets; en Altare agrégala en Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública donde corre la aplicación (opcional en polling, requerida para webhook).
APP_URL="MY_APP_URL"

# PORT: Puerto HTTP asignado por Altare o entorno local (por defecto 3000).
PORT=3000

# TELEGRAM_BOT_TOKEN: Token obtenido desde @BotFather en Telegram.
# Cuando está definido, el servidor arranca automáticamente el bot real en paralelo con la consola web.
TELEGRAM_BOT_TOKEN=""

# WEBHOOK_URL: Opcional. Si se deja vacío en Altare, el bot utiliza Long Polling de forma automática y segura.
# Ejemplo si prefieres webhook: https://tu-app.altare.sh/api/telegram/webhook
WEBHOOK_URL=""

# ADMIN_CHAT_ID: Opcional. ID numérico de Telegram del administrador para notificaciones de inicio o alertas.
ADMIN_CHAT_ID=""
